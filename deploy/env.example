# 复制为项目根目录 .env，执行脚本时会自动加载
APP_PORT=8080
# 对外流量由 Nginx 承接。只有确实需要直接开放后端时才改为 0.0.0.0。
SERVER_ADDRESS=127.0.0.1
# JWT 登录令牌密钥：生产环境请使用随机的 64 字符以上字符串，绝不提交真实值。
AUTH_JWT_SECRET=请替换为至少32字符的随机密钥
AUTH_JWT_EXPIRES_SECONDS=28800
JAVA_OPTS="-Xms512m -Xmx1536m -XX:+UseG1GC -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai"
INSTALL_LOCAL_MYSQL=true
SERVICE_USER=root
DOMAIN=_
# Comma-separated browser origins allowed to call the API. Set the exact HTTPS
# web front-end origin(s) in production; do not use *.
CORS_ALLOWED_ORIGINS=https://你的前端域名

# 网页端邮箱验证码注册。QQ/163/企业邮箱请填写 SMTP 授权码，不是邮箱登录密码。
EMAIL_VERIFICATION_ENABLED=false
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_PROTOCOL=smtps
EMAIL_SMTP_SSL=true
EMAIL_SMTP_STARTTLS=false
EMAIL_FROM=
# 至少32位随机字符串，只用于验证码摘要，不能使用示例值。
EMAIL_VERIFICATION_SECRET=

# 首次部署可临时启用一次性管理员初始化；创建成功后立即改为 false 并重启。
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_AGE=30

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shixun
DB_USER=smart_pig
DB_PASSWORD=请改成高强度数据库密码
MYSQL_ADMIN_USER=root
# Ubuntu本机MySQL通常留空即可通过sudo mysql初始化；RDS必须填写管理员密码
MYSQL_ADMIN_PASSWORD=

# 新订单默认只允许官方微信支付。人工收款码仅用于极端维护期的历史兼容，保持 false。
PAYMENT_MANUAL_QR_URL=/payment-collection-qr.jpg
PAYMENT_MANUAL_QR_ENABLED=false
# 私有创作资产目录必须位于网页静态目录之外。
CREATIVE_ASSET_PRIVATE_ROOT=/opt/smart_pig/shixun/data/creative-assets

QWEN_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_CHAT_MODEL=Qwen/Qwen3-32B
SILICONFLOW_IMAGE_MODEL=Kwai-Kolors/Kolors
SILICONFLOW_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit-2509

# Tripo 图生3D
TRIPO_API_KEY=
TRIPO_API_BASE_URL=https://openapi.tripo3d.com/v3
TRIPO_CONVERT_BASE_URL=https://api.tripo3d.ai/v2/openapi
TRIPO_MODEL_VERSION=v3.1-20260211

# 3D模型下载格式转换：优先服务器本地转换 GLB -> OBJ/STL；需安装 Blender（推荐）或 assimp
MODEL_CONVERT_PREFER_LOCAL=true
MODEL_CONVERT_FALLBACK_TRIPO=false
MODEL_CONVERT_BLENDER_COMMAND=blender
MODEL_CONVERT_ASSIMP_COMMAND=assimp
MODEL_CONVERT_NODE_COMMAND=node
MODEL_CONVERT_TIMEOUT_SECONDS=300

# Google Imagen 4 via Replicate（2D创意生图首选服务商）
REPLICATE_API_KEY=
REPLICATE_API_BASE_URL=https://api.replicate.com/v1
REPLICATE_IMAGEN_MODEL=google/imagen-4

# 火山引擎即梦AI-图片生成4.6（当前首选2D生图）
# 注意：这份视觉接口需要火山 AccessKeyId + SecretAccessKey 签名鉴权；Vx开头的 API Key 不能直接用于该接口。
JIMENG_API_KEY=
JIMENG_ACCESS_KEY_ID=
JIMENG_SECRET_ACCESS_KEY=
JIMENG_REGION=cn-north-1
JIMENG_SERVICE=cv
JIMENG_API_BASE_URL=https://visual.volcengineapi.com
JIMENG_REQ_KEY=jimeng_seedream46_cvtob
JIMENG_POLL_MAX_SECONDS=180

# 火山引擎 Ark / Doubao Seedream 用户端生图与多视图（与上面的即梦 AK/SK 不同，通常以 Vx 开头）
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_ARK_SEEDREAM_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
VOLCENGINE_ARK_SEEDREAM_MULTIVIEW_MODEL=doubao-seedream-5-0-260128

# 墨刀 AI 设计（2D创意生图可选服务商）
MODAO_API_KEY=
MODAO_DESIGN_URL=https://modao.cc/ai/design/spmrsxjgcyi6g0h1/6a5dd48151e5a21110c1697a
MODAO_MCP_URL=https://modao.cc/agent-py/ai/mcp
MODAO_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
KUAIDI100_CALLBACK_URL=https://你的域名/api/logistics/callback/kuaidi100
KUAIDI100_SALT=

# 微信支付 API v3（网页 Native 扫码 + 微信小程序 JSAPI）
# 上线前填写微信支付商户平台发放的信息；私钥、APIv3 Key、微信支付公钥仅保存在服务器，禁止提交 Git。
# PAYMENT_WECHAT_APP_ID 必须与小程序 manifest.json 的 appid 一致（当前为 wxd1ba9e6e01d0e3db）。
PAYMENT_WECHAT_ENABLED=false
PAYMENT_WECHAT_APP_ID=wxd1ba9e6e01d0e3db
# 小程序 AppSecret；仅服务器保存，用于 uni.login code 换取 OpenID，绝不放进前端构建产物。
PAYMENT_WECHAT_MINI_APP_SECRET=
# 网页扫码登录使用微信开放平台“网站应用”，不是上面的小程序 AppID。
PAYMENT_WECHAT_WEB_APP_ID=
PAYMENT_WECHAT_WEB_APP_SECRET=
PAYMENT_WECHAT_WEB_REDIRECT_URI=https://你的域名/api/users/wechat-web/callback
PAYMENT_WECHAT_WEB_SUCCESS_URL=https://你的域名/
PAYMENT_WECHAT_MCH_ID=
PAYMENT_WECHAT_SERIAL_NO=
PAYMENT_WECHAT_PRIVATE_KEY_PATH=/opt/smart_pig/secrets/apiclient_key.pem
PAYMENT_WECHAT_API_V3_KEY=
PAYMENT_WECHAT_NOTIFY_URL=https://你的域名/api/payments/wechat/notify
# 退款通知使用独立 URL，须在微信商户平台/网关可回调的 HTTPS 域名下。
PAYMENT_WECHAT_REFUND_NOTIFY_URL=https://你的域名/api/payments/wechat/refund-notify
# 从微信支付商户平台下载的 pub_key.pem；文件名可自定义，但路径必须与服务器一致。
PAYMENT_WECHAT_PLATFORM_PUBLIC_KEY_PATH=/opt/smart_pig/secrets/wechatpay_public_key.pem
# 微信支付公钥 ID（格式类似 PUB_KEY_ID_xxx），用于校验 Wechatpay-Serial 请求头。
PAYMENT_WECHAT_PLATFORM_SERIAL_NO=
# 保持已验签支付通知的短时窗口；定时主动对账用于回调丢失、超时和退款不明。
PAYMENT_WECHAT_CALLBACK_MAX_AGE_SECONDS=300
PAYMENT_WECHAT_RECONCILE_ENABLED=true
PAYMENT_WECHAT_RECONCILE_DELAY_MS=300000
PAYMENT_WECHAT_RECONCILE_LIMIT=40
# 昨日账单通常北京时间10:00后生成，建议10:30或更晚；失败记录会保留供重试。
PAYMENT_WECHAT_DAILY_RECONCILE_CRON="0 30 10 * * *"
# 同日14:30重试当天早些时候下载失败的账单。
PAYMENT_WECHAT_DAILY_RECONCILE_RETRY_CRON="0 30 14 * * *"

# 微信小程序虚拟支付。AppKey、OfferId 和会话加密密钥在微信公众平台的
# “虚拟支付 - 基础配置”获取；它们不是微信商户 APIv3 密钥，也不是 AI 服务密钥。
# 正式版使用 ENV=0 与正式 AppKey；仅调试版可使用 ENV=1 与沙箱 AppKey。
PAYMENT_WECHAT_VIRTUAL_ENABLED=false
PAYMENT_WECHAT_VIRTUAL_OFFER_ID=
PAYMENT_WECHAT_VIRTUAL_ENV=0
PAYMENT_WECHAT_VIRTUAL_PRODUCTION_APP_KEY=
PAYMENT_WECHAT_VIRTUAL_SANDBOX_APP_KEY=
# 由微信虚拟支付后台生成的 32 字节会话加密密钥，仅保存在服务器。
PAYMENT_WECHAT_VIRTUAL_SESSION_ENCRYPTION_KEY=
